# PostgreSQL connection string (set in your hosting provider's secret environment)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Generate a long random value before enabling authentication
AUTH_SECRET="replace-with-a-long-random-secret"

# Payment integration stays disabled until a supported provider account is configured
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=
